<?php
session_start();

if(isset($_SESSION["user"])){
    if($_SESSION["user"]=="" || $_SESSION['usertype']!='p'){
        header("location: ../login.php");
        exit();
    }else{
        $useremail=$_SESSION["user"];
    }
}else{
    header("location: ../login.php");
    exit();
}

include("../connection.php");
include("../config.php"); 

if(isset($_GET['scheduleid']) && isset($_GET['fee'])){
    $scheduleid = $_GET['scheduleid'];
    $total_fee  = $_GET['fee'];

    // ✅ FIXED QUERY (removed d.consultation_fee)
    $sql = "SELECT s.*, d.docname, d.docemail
            FROM schedule s
            JOIN doctor d ON s.docid = d.docid
            WHERE s.scheduleid = ?";

    $stmt = $database->prepare($sql);
    $stmt->bind_param("i", $scheduleid);
    $stmt->execute();
    $result = $stmt->get_result();
    $schedule = $result->fetch_assoc();
    $stmt->close();

    if(!$schedule){
        header("location: schedule.php");
        exit();
    }

    // Fees
    $consultation_fee     = $schedule["session_fee"];
    $hospital_service_fee = HOSPITAL_SERVICE_FEE;
    $fee                  = $total_fee;

    // Patient details
    $sql_patient = "SELECT * FROM patient WHERE pemail = ?";
    $stmt_patient = $database->prepare($sql_patient);
    $stmt_patient->bind_param("s", $useremail);
    $stmt_patient->execute();
    $result_patient = $stmt_patient->get_result();
    $patient = $result_patient->fetch_assoc();
    $stmt_patient->close();

}else{
    header("location: index.php");
    exit();
}
?>
