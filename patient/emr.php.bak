$sqlmain= "select * from patient where pemail=?";
$stmt = $database->prepare($sqlmain);
$stmt->bind_param("s",$useremail);
$stmt->execute();
$userrow = $stmt->get_result();
$userfetch=$userrow->fetch_assoc();
$patient_id=$userfetch["pid"];
$username=$userfetch["pname"];

// Check if medical_records table exists
$sql_check = "SHOW TABLES LIKE 'medical_records'";
$result_check = $database->query($sql_check);

if ($result_check->num_rows > 0) {
    // Use medical_records table if it exists
    $sql_records = "SELECT mr.*, d.docname as doctor_name 
                    FROM medical_records mr 
                    INNER JOIN doctor d ON mr.doctor_id = d.docid 
                    WHERE mr.patient_id = ? 
                    ORDER BY mr.visit_date DESC";
    $stmt_records = $database->prepare($sql_records);
    $stmt_records->bind_param("i", $patient_id);
    $stmt_records->execute();
    $records_result = $stmt_records->get_result();
} else {
    // Fall back to medical_documents table if medical_records doesn't exist
    $sql_docs = "SELECT md.*, d.docname FROM medical_documents md 
                 JOIN doctor d ON md.doctor_id = d.docid 
                 WHERE md.patient_id = ? 
                 ORDER BY md.created_date DESC";
    $stmt_docs = $database->prepare($sql_docs);
    $stmt_docs->bind_param("i", $patient_id);
    $stmt_docs->execute();
    $records_result = $stmt_docs->get_result();
}

